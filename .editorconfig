root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{js,vue,json,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 要靠 BOM 才能正确读中文
[*.ps1]
charset = utf-8-bom
